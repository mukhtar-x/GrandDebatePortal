# Copy to .env.local and fill in development credentials.
# Never commit .env.local or production secrets.

# Required for registration, status lookup, admin data, and receipt storage.
MONGODB_URI=mongodb://127.0.0.1:27017/granddebateportal?replicaSet=rs0

# Required for organiser sign-in. Generate a scrypt hash with:
# npx tsx scripts/hash-admin-password.ts 'a unique password of at least 8 characters'
# Then set ADMIN_USERS to a JSON array of objects with userId, name and passwordHash fields.
# In .env.local, escape each hash separator as \$ (for Next.js dotenv expansion).
ADMIN_USERS=[]

# Optional receipt AI second opinion. Disabled unless both key and model are set.
# This sends receipt data to the configured third-party service.
RECEIPT_AI_KEY=
RECEIPT_AI_MODEL=
# Defaults to Google's Gemini OpenAI-compatible endpoint when omitted.
# RECEIPT_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Optional test: npm run test:api uses localhost:3000 by default.
# API_BASE_URL=http://localhost:3000
# TEST_STATUS_EMAIL=amina.solo@example.com
# TEST_STATUS_APPLICATION_ID=TGD-2026-SEED-SOLO

# Keep write tests disabled for routine checks. Never point write tests at production.
# RUN_WRITE_TESTS=
# ALLOW_REMOTE_WRITE_TESTS=
